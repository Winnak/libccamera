include("${CMAKE_CURRENT_LIST_DIR}/ccameraIpaSigning.cmake")

function(ccamera_ipa_prepare_key private public directory header output_key)
    ccamera_ipa_host_openssl(openssl)
    file(MAKE_DIRECTORY "${directory}")
    if(NOT private AND NOT public)
        set(private "${directory}/development.pem")
        if(NOT EXISTS "${private}")
            # Private material is generated inside an owner-only directory,
            # then published atomically with mode 0600, never via a public temp.
            execute_process(COMMAND chmod 700 "${directory}" RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Cannot protect IPA key directory")
            endif()
            execute_process(COMMAND "${openssl}" genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
                -out "${private}.tmp" RESULT_VARIABLE result ERROR_VARIABLE error)
            if(NOT result EQUAL 0)
                file(REMOVE "${private}.tmp")
                message(FATAL_ERROR "IPA development key generation failed: ${error}")
            endif()
            execute_process(COMMAND chmod 600 "${private}.tmp" RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                file(REMOVE "${private}.tmp")
                message(FATAL_ERROR "Cannot protect IPA development key")
            endif()
            file(RENAME "${private}.tmp" "${private}")
        endif()
    endif()
    if(private)
        get_filename_component(private "${private}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        set(input "${private}")
        set(arguments)
    else()
        get_filename_component(public "${public}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        set(input "${public}")
        set(arguments -pubin)
    endif()
    if(NOT EXISTS "${input}" OR IS_DIRECTORY "${input}")
        message(FATAL_ERROR "IPA key is not a file: ${input}")
    endif()
    file(READ "${input}" pem LIMIT 1048576)
    if(NOT pem MATCHES "-----BEGIN (RSA )?(PUBLIC|PRIVATE) KEY-----" OR pem MATCHES "ENCRYPTED")
        message(FATAL_ERROR "IPA keys must be unencrypted PEM RSA keys")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
    set(der "${directory}/public.der")
    execute_process(COMMAND "${openssl}" pkey ${arguments} -in "${input}" -inform PEM -passin pass:
        -pubout -outform DER -out "${der}" RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot read IPA key: ${error}")
    endif()
    file(READ "${der}" hex HEX)
    # SubjectPublicKeyInfo must carry rsaEncryption, not RSASSA-PSS or EC.
    if(NOT hex MATCHES "^30(82....|81..|..)300d06092a864886f70d0101010500")
        message(FATAL_ERROR "IPA signing supports plain RSA keys only (PKCS#1 v1.5)")
    endif()
    execute_process(COMMAND "${openssl}" pkey -pubin -inform DER -in "${der}" -pubcheck -noout
        RESULT_VARIABLE result ERROR_VARIABLE error OUTPUT_QUIET)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Invalid IPA RSA public key: ${error}")
    endif()
    if(private)
        execute_process(COMMAND "${openssl}" dgst -sha256 -sign "${private}" -keyform PEM -passin pass:
            -sigopt rsa_padding_mode:pkcs1 -out "${directory}/probe.sign" "${der}"
            RESULT_VARIABLE result ERROR_VARIABLE error)
        file(REMOVE "${directory}/probe.sign")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot sign with IPA private key: ${error}")
        endif()
    endif()
    string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
    file(WRITE "${header}.in" "/* Generated public SubjectPublicKeyInfo; no private material. */\nstatic const unsigned char cc_ipa_public_key[] = {${bytes}};\n")
    configure_file("${header}.in" "${header}" COPYONLY)
    file(REMOVE "${header}.in")
    set(${output_key} "${private}" PARENT_SCOPE)
endfunction()
